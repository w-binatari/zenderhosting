# Desk rates (WhatsApp + API)
BLOB_READ_WRITE_TOKEN=
RATES_UPDATE_SECRET=

# Meta WhatsApp Cloud API (desk rate updates)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Meta app secret, used to verify X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_NUMBERS=2348012345678

# Optional override for the public click-to-chat number, digits only.
# The site publishes 2349035573575 when this is empty.
NEXT_PUBLIC_WHATSAPP_E164=

# Enquiries are written to HubSpot through Vercel Connect connector hubspot/zender-finance.
# Create it with: vercel connect create hubspot --name zender-finance

# Search engine verification codes (content of the meta tag only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
